_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
# Ignore folders generated by Bundler
.bundle/
vendor/

# Python (python/)
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Go (go/)
go/bin/

# Terraform (infra/terraform/)
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
terraform.tfvars

# Local dev stack (docker-compose.yml / docs/LOCAL_DEV.md) -- fake-gcs-server persists
# objects into these mounted directories, and .gitkeep is all that should be tracked.
infra/docker/gcs-data/*/*
!infra/docker/gcs-data/*/.gitkeep

# Sample-run output (python/scripts/demo_*.py) -- deterministic given the fixed seed each
# demo script hardcodes, so it's regenerable on demand and not worth tracking; the event
# log alone runs tens of MB per run.
python/scripts/demo_output/

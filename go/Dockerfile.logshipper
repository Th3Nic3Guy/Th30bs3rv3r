# Log shipper image (PRD Section 6.5, 9). Runs as a sidecar/second process on each
# simulation run's Compute Engine instance, alongside the Python engine image
# (python/Dockerfile).
FROM golang:1.25 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/logshipper ./cmd/logshipper

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/logshipper /logshipper
ENTRYPOINT ["/logshipper"]

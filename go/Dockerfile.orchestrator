# Run orchestrator image (PRD Section 9). Runs off-cluster (a developer's machine, a CI
# job, or a small always-on Cloud Run job) — not on the per-run simulation instances.
FROM golang:1.25 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/orchestrator ./cmd/orchestrator

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/orchestrator /orchestrator
ENTRYPOINT ["/orchestrator"]
